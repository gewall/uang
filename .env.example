# Dev lokal: DB uang_dev di VPS lewat SSH tunnel (jalankan `npm run db:tunnel` di terminal terpisah)
DATABASE_URL=postgres://uang_dev:CHANGE_ME@127.0.0.1:15432/uang_dev

# >= 32 byte acak: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME

# 32 byte base64, HANYA untuk mengenkripsi API key AI yang diisi dari UI:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=CHANGE_ME

APP_URL=http://localhost:3000
COOKIE_SECURE=false
TZ=Asia/Jakarta
