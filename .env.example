# Koneksi PostgreSQL
DATABASE_URL=postgres://uang:CHANGE_ME@localhost:5432/uang

# (opsional) CA sertifikat server Postgres (PEM) untuk koneksi TLS terverifikasi.
# Boleh satu baris dengan "\n" sebagai pemisah baris.
# DATABASE_CA=

# >= 32 byte acak: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME

# 32 byte base64, HANYA untuk mengenkripsi API key AI yang diisi dari UI:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=CHANGE_ME

APP_URL=http://localhost:3000
# true di production (HTTPS)
COOKIE_SECURE=false
